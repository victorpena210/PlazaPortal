# Supply these in your IDE run configuration or hosting environment.
# Spring Boot does not automatically read a .env file.
DB_URL=jdbc:mysql://localhost:3306/pena_plaza?serverTimezone=UTC
DB_USERNAME=plazaportal
DB_PASSWORD=REPLACE_ME
APP_BASE_URL=http://localhost:8080
APP_TIME_ZONE=America/Chicago
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS
OWNER_SIGNUP_ENABLED=false
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL=false
SESSION_COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit company ID to approved receiving account; no default recipient.
# Example: 1:platform OR 1:acct_example,2:acct_other
STRIPE_COMPANY_ACCOUNTS=
STRIPE_LIVE_MODE=false
